<Page
    x:Class="Mirror_App.Views.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" HorizontalAlignment="Stretch" Margin="8,0,32,32">
            <StackPanel Spacing="4">
                <TextBlock Text="NPU Acceleration &amp; Hardware Diagnostics" FontSize="26" FontWeight="Bold" />
                <TextBlock Text="Real telemetry from local ONNX Runtime execution providers and database storage." FontSize="14" Foreground="#888888" />
            </StackPanel>

            <!-- Hardware Telemetry Cards -->
            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="16">
                <!-- Backend Card -->
                <Border Grid.Column="0" Background="#11FFFFFF" BorderBrush="#22888888" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="ACTIVE EXECUTION PROVIDER" FontSize="10" FontWeight="Bold" Foreground="#888888" />
                        <TextBlock x:Name="TxtBackend" Text="Snapdragon NPU / QNN" FontSize="18" FontWeight="Bold" Foreground="#107C41" />
                        <TextBlock Text="Qualcomm Hexagon NPU" FontSize="11" Foreground="#666666" />
                    </StackPanel>
                </Border>

                <!-- Model Format Card -->
                <Border Grid.Column="1" Background="#11FFFFFF" BorderBrush="#22888888" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="QUANTIZATION PROFILE" FontSize="10" FontWeight="Bold" Foreground="#888888" />
                        <TextBlock Text="Static QDQ INT8" FontSize="18" FontWeight="Bold" Foreground="#0078D4" />
                        <TextBlock Text="13.5 KB zero-overhead model" FontSize="11" Foreground="#666666" />
                    </StackPanel>
                </Border>

                <!-- Memory Card -->
                <Border Grid.Column="2" Background="#11FFFFFF" BorderBrush="#22888888" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="MEMORY FOOTPRINT" FontSize="10" FontWeight="Bold" Foreground="#888888" />
                        <TextBlock x:Name="TxtMemory" Text="18.4 MB" FontSize="18" FontWeight="Bold" Foreground="#8764B8" />
                        <TextBlock Text="Strictly under 40 MB budget" FontSize="11" Foreground="#666666" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Detailed Specifications -->
            <Border Background="#0CFFFFFF" BorderBrush="#22888888" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Engine Specifications" FontSize="18" FontWeight="SemiBold" />

                    <Grid RowDefinitions="Auto, Auto, Auto, Auto" ColumnDefinitions="*, *" RowSpacing="12">
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                            <TextBlock Text="TENSOR GEOMETRY" FontSize="10" FontWeight="Bold" Foreground="#888888" />
                            <TextBlock Text="[1, 60, 10] (Batch=1, Mins=60, Feats=10)" FontSize="13" FontWeight="SemiBold" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                            <TextBlock Text="INFERENCE LATENCY" FontSize="10" FontWeight="Bold" Foreground="#888888" />
                            <TextBlock x:Name="TxtLatency" Text="0.02 ms (P50 steady-state)" FontSize="13" FontWeight="SemiBold" Foreground="#107C41" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                            <TextBlock Text="STORAGE ARCHITECTURE" FontSize="10" FontWeight="Bold" Foreground="#888888" />
                            <TextBlock Text="SQLite WAL Mode (PRAGMA synchronous = NORMAL)" FontSize="13" FontWeight="SemiBold" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                            <TextBlock Text="DATABASE SIZE ON DISK" FontSize="10" FontWeight="Bold" Foreground="#888888" />
                            <TextBlock x:Name="TxtDbSize" Text="128.0 KB" FontSize="13" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Live Benchmark Runner -->
            <Border Background="#0CFFFFFF" BorderBrush="#22888888" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Live Hardware Benchmark" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="TxtBenchmarkLog" Text="Ready to execute 100 on-device inference passes." Foreground="#CCCCCC" FontSize="13" TextWrapping="Wrap" />

                    <Button x:Name="BtnRunBenchmark" Content="Run On-Device Inference Benchmark" Click="OnRunBenchmarkClicked" Background="#200078D4" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
