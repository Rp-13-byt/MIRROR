<Page
    x:Class="Mirror_App.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" HorizontalAlignment="Stretch" Margin="8,0,32,32">
            <!-- Header & Audio Narration Action -->
            <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Today's Observability" FontSize="26" FontWeight="Bold" />
                    <TextBlock Text="Local descriptive usage metrics and category distribution updating in real time." FontSize="14" Foreground="#888888" />
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding ToggleNarrationCommand}" VerticalAlignment="Center" Padding="14,8" CornerRadius="8" Background="#180EA5E9" BorderBrush="#330EA5E9">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="{Binding NarrationIcon}" FontSize="15" Foreground="#0EA5E9" />
                        <TextBlock Text="{Binding NarrationButtonText}" FontSize="13" FontWeight="SemiBold" Foreground="#0EA5E9" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Flow State Achieved Positive Reinforcement Card -->
            <Border Background="#1210B981" BorderBrush="#4010B981" BorderThickness="1" CornerRadius="10" Padding="16" Visibility="{Binding HasFlowState, Mode=OneWay}">
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border Background="#2510B981" BorderBrush="#5010B981" BorderThickness="1" CornerRadius="8" Padding="10,6" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE735;" FontSize="13" Foreground="#10B981" />
                                <TextBlock Text="FLOW STATE ACHIEVED" FontSize="11" FontWeight="Bold" Foreground="#10B981" />
                            </StackPanel>
                        </Border>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FlowTitle, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="#E2E8F0" />
                            <TextBlock Text="{Binding FlowDetails, Mode=OneWay}" FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <Border Background="#2000B7C3" BorderBrush="#4000B7C3" BorderThickness="1" CornerRadius="6" Padding="12,6">
                            <TextBlock Text="{Binding FlowBadge, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="#00B7C3" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Live Active Session Hero Card -->
            <Border Background="#120078D4" BorderBrush="#330078D4" BorderThickness="1" CornerRadius="10" Padding="18">
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <!-- Left: Live Status & App Name -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <Border Background="#20107C41" BorderBrush="#40107C41" BorderThickness="1" CornerRadius="8" Padding="10,6" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="#107C41" />
                                <TextBlock Text="LIVE NOW" FontSize="11" FontWeight="Bold" Foreground="#107C41" />
                            </StackPanel>
                        </Border>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentAppName, Mode=OneWay}" FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="{Binding CurrentProcessName, Mode=OneWay}" FontSize="12" Foreground="#888888" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Center: Category Badge -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Background="#15FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,4">
                            <TextBlock Text="{Binding CurrentCategory, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="#CCCCCC" />
                        </Border>
                    </StackPanel>

                    <!-- Right: Live Elapsed Duration -->
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="CURRENT FOCUS DURATION" FontSize="10" FontWeight="Bold" Foreground="#888888" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding CurrentSessionElapsed, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="#0078D4" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Metrics Cards Grid -->
            <Grid ColumnDefinitions="*, *, *, *" ColumnSpacing="16">
                <!-- Card 1: Active Time -->
                <Border Grid.Column="0" Background="#11FFFFFF" BorderBrush="#22888888" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="TOTAL ACTIVE TIME" FontSize="11" FontWeight="SemiBold" Foreground="#888888" />
                        <TextBlock x:Name="TxtTotalActive" Text="{Binding TotalActiveTime, Mode=OneWay}" FontSize="26" FontWeight="Bold" Foreground="#0078D4" />
                        <TextBlock Text="Continuous interaction" FontSize="11" Foreground="#666666" />
                    </StackPanel>
                </Border>

                <!-- Card 2: Idle Time -->
                <Border Grid.Column="1" Background="#11FFFFFF" BorderBrush="#22888888" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="TOTAL IDLE TIME" FontSize="11" FontWeight="SemiBold" Foreground="#888888" />
                        <TextBlock x:Name="TxtTotalIdle" Text="{Binding TotalIdleTime, Mode=OneWay}" FontSize="26" FontWeight="Bold" Foreground="#107C41" />
                        <TextBlock Text="No mouse/keyboard input" FontSize="11" Foreground="#666666" />
                    </StackPanel>
                </Border>

                <!-- Card 3: Context Switches -->
                <Border Grid.Column="2" Background="#11FFFFFF" BorderBrush="#22888888" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="CONTEXT SWITCHES" FontSize="11" FontWeight="SemiBold" Foreground="#888888" />
                        <TextBlock x:Name="TxtContextSwitches" Text="{Binding ContextSwitches, Mode=OneWay}" FontSize="26" FontWeight="Bold" Foreground="#8764B8" />
                        <TextBlock Text="Window focus transitions" FontSize="11" Foreground="#666666" />
                    </StackPanel>
                </Border>

                <!-- Card 4: Primary Category -->
                <Border Grid.Column="3" Background="#11FFFFFF" BorderBrush="#22888888" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="PRIMARY CATEGORY" FontSize="11" FontWeight="SemiBold" Foreground="#888888" />
                        <TextBlock x:Name="TxtPrimaryCat" Text="{Binding PrimaryCategory, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="#D83B01" TextWrapping="Wrap" MaxLines="1" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="Leading activity focus" FontSize="11" Foreground="#666666" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Two-Column Section: Category Breakdown + Top Applications -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="20">
                <!-- Categories -->
                <Border Grid.Column="0" Background="#0CFFFFFF" BorderBrush="#22888888" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Activity by Category" FontSize="18" FontWeight="SemiBold" />
                        <ListView x:Name="ListCategories" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,4">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Medium" />
                                        <TextBlock Grid.Column="1" Text="{Binding DurationFormatted}" Foreground="#888888" Margin="0,0,16,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding Percentage, Mode=OneWay}" FontWeight="SemiBold" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Top Applications -->
                <Border Grid.Column="1" Background="#0CFFFFFF" BorderBrush="#22888888" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Top Applications Today" FontSize="18" FontWeight="SemiBold" />
                        <ListView x:Name="ListTopApps" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto, *, Auto, Auto" Margin="0,4">
                                        <FontIcon Grid.Column="0" Glyph="&#xE756;" FontSize="14" Margin="0,0,12,0" Foreground="#0078D4" />
                                        <TextBlock Grid.Column="1" Text="{Binding ProcessName}" FontWeight="Medium" />
                                        <TextBlock Grid.Column="2" Text="{Binding DurationFormatted}" Foreground="#888888" Margin="0,0,16,0" />
                                        <TextBlock Grid.Column="3" Text="{Binding Percentage, Mode=OneWay}" FontWeight="SemiBold" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Recent Detected Patterns Ribbon -->
            <Border Background="#0CFFFFFF" BorderBrush="#22888888" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Recent Behavioral Highlights (On-Device Inference)" FontSize="18" FontWeight="SemiBold" />
                    <ListView x:Name="ListRecentPatterns" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#080078D4" BorderBrush="#220078D4" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,4">
                                    <Grid ColumnDefinitions="Auto, *">
                                        <FontIcon Grid.Column="0" Glyph="&#xE9D9;" FontSize="18" Foreground="#0078D4" Margin="0,0,14,0" VerticalAlignment="Top" />
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding PatternType}" FontWeight="SemiBold" FontSize="14" />
                                                    <Border Background="#200078D4" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="{Binding ConfidenceText, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="#0078D4" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding FormattedTimestamp, Mode=OneWay}" FontSize="11" Foreground="#888888" />
                                            </Grid>
                                            <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Foreground="#CCCCCC" FontSize="13" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
