<Page
    x:Class="Mirror_App.Views.PatternsPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" HorizontalAlignment="Stretch" Margin="8,0,32,32">
            <StackPanel Spacing="4">
                <TextBlock Text="Behavioral Patterns" FontSize="26" FontWeight="Bold" />
                <TextBlock Text="Descriptive patterns detected locally via deterministic rules corroborated by the 1D-CNN temporal sequence model." FontSize="14" Foreground="#888888" />
            </StackPanel>

            <!-- Empty State when no patterns detected -->
            <Border x:Name="EmptyPatternsBanner" Background="#0AFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,8">
                <Grid ColumnDefinitions="Auto, *">
                    <FontIcon Grid.Column="0" Glyph="&#xE73E;" FontSize="28" Foreground="#107C41" Margin="0,0,18,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Optimal Focus Rhythm — No Disruptive Patterns Detected" FontSize="16" FontWeight="Bold" Foreground="#107C41" />
                        <TextBlock Text="Observability runs continuously on-device. If unusual application switching bursts, excessive late-night shifts, or rapid reopen loops occur, descriptive observations corroborated by on-device ML inference will appear here." FontSize="13" Foreground="#888888" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Patterns List with Explanations -->
            <ListView x:Name="ListPatterns" SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#0CFFFFFF" BorderBrush="#22888888" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,6">
                            <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto">
                                <!-- Top: Pattern Name + Confidence Badge -->
                                <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="{Binding PatternTitle}" FontSize="18" FontWeight="Bold" />
                                        <Border Background="{Binding ColorHex}" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Confidence}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Timestamp, Mode=OneWay}" Foreground="#888888" FontSize="12" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Middle: Neutral Descriptive Explanation -->
                                <TextBlock Grid.Row="1" Text="{Binding Explanation}" TextWrapping="Wrap" FontSize="14" Margin="0,12,0,8" Foreground="#DDDDDD" />

                                <!-- Bottom: Evidence Summary & Observed vs Baseline -->
                                <Border Grid.Row="2" Background="#08FFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,4,0,0">
                                    <Grid ColumnDefinitions="*, Auto, Auto">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="OBSERVED EVIDENCE" FontSize="10" FontWeight="Bold" Foreground="#888888" />
                                            <TextBlock Text="{Binding EvidenceSummary}" FontSize="12" Foreground="#AAAAAA" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2" Margin="24,0,16,0">
                                            <TextBlock Text="OBSERVED" FontSize="10" FontWeight="Bold" Foreground="#888888" />
                                            <TextBlock Text="{Binding ObservedValue}" FontSize="13" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="2">
                                            <TextBlock Text="BASELINE" FontSize="10" FontWeight="Bold" Foreground="#888888" />
                                            <TextBlock Text="{Binding BaselineValue}" FontSize="13" FontWeight="SemiBold" Foreground="#888888" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Innovation: Action Bar (Explain with Local AI & This isn't accurate) -->
                                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12" Margin="0,12,0,0">
                                    <Button Command="{Binding ElementName=RootPage, Path=DataContext.ExplainWithAiCommand}" CommandParameter="{Binding}" Padding="12,6" CornerRadius="6" Background="#180EA5E9" BorderBrush="#330EA5E9">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE946;" FontSize="13" Foreground="#0EA5E9" />
                                            <TextBlock Text="Explain with Local AI" FontSize="12" FontWeight="SemiBold" Foreground="#0EA5E9" />
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding ElementName=RootPage, Path=DataContext.RecalibrateCommand}" CommandParameter="{Binding}" Padding="12,6" CornerRadius="6" Background="#10FFFFFF" BorderBrush="#20FFFFFF">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="#94A3B8" />
                                            <TextBlock Text="This isn't accurate" FontSize="12" Foreground="#94A3B8" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- Innovation: Local AI RAG Explanation Box -->
                                <Border Grid.Row="4" Background="#150EA5E9" BorderBrush="#330EA5E9" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,10,0,0" Visibility="{Binding HasAiExplanation, Mode=OneWay}">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="#0EA5E9" />
                                            <TextBlock Text="LOCAL SLM REASONING (ON-DEVICE)" FontSize="10" FontWeight="Bold" Foreground="#0EA5E9" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding AiExplanation, Mode=OneWay}" FontSize="13" Foreground="#E2E8F0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Innovation: Recalibration Status Feedback -->
                                <Border Grid.Row="5" Background="#1510B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,10,0,0" Visibility="{Binding IsRecalibrated, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="#10B981" />
                                        <TextBlock Text="{Binding RecalibrationStatus, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="#10B981" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
