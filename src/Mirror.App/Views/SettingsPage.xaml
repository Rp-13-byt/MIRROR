<Page
    x:Class="Mirror_App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" HorizontalAlignment="Stretch" Margin="8,0,32,32">
            <StackPanel Spacing="4">
                <TextBlock Text="Settings &amp; Preferences" FontSize="26" FontWeight="Bold" />
                <TextBlock Text="Configure startup behavior, tray presence, idle thresholds, and process exclusions." FontSize="14" Foreground="#888888" />
            </StackPanel>

            <!-- General Settings -->
            <Border Background="#0CFFFFFF" BorderBrush="#22888888" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Application Behavior" FontSize="18" FontWeight="SemiBold" />

                    <ToggleSwitch x:Name="ToggleStartup" Header="Launch at Windows Startup" OffContent="Disabled" OnContent="Enabled" Toggled="OnSettingsChanged" />
                    <ToggleSwitch x:Name="ToggleTray" Header="Minimize to System Tray on Close" OffContent="Exit App" OnContent="Minimize to Tray" Toggled="OnSettingsChanged" />
                    <ToggleSwitch x:Name="ToggleNpu" Header="Qualcomm NPU Hardware Acceleration" OffContent="Use CPU" OnContent="Prioritize NPU/DirectML" Toggled="OnSettingsChanged" />
                </StackPanel>
            </Border>

            <!-- Tracking Mode & Privacy Pause -->
            <Border Background="#0CFFFFFF" BorderBrush="#22888888" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Tracking Modes &amp; Privacy Pause" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Configure tracking boundaries and pause tracking at any moment." FontSize="13" Foreground="#888888" />

                    <StackPanel Spacing="8">
                        <TextBlock Text="Tracking Mode" FontSize="14" FontWeight="Medium" />
                        <ComboBox x:Name="ComboTrackingMode" SelectedIndex="{Binding TrackingModeIndex, Mode=TwoWay}" SelectionChanged="OnTrackingModeChanged" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Track All Applications (Default)" />
                            <ComboBoxItem Content="Track Selected Applications Only" />
                            <ComboBoxItem Content="Track Selected Categories Only" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Privacy Pause Presets" FontSize="14" FontWeight="Medium" />
                        <TextBlock Text="{Binding PauseStatusMessage, Mode=OneWay}" FontSize="13" Foreground="#0078D4" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Pause 15m" Command="{Binding Pause15MinutesCommand}" />
                            <Button Content="Pause 1h" Command="{Binding Pause1HourCommand}" />
                            <Button Content="Pause 4h" Command="{Binding Pause4HoursCommand}" />
                            <Button Content="Pause Until Tomorrow" Command="{Binding PauseUntilTomorrowCommand}" />
                            <Button Content="Resume Tracking" Command="{Binding ResumeTrackingCommand}" Background="#20107C41" Foreground="#107C41" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Behavioral Pattern Visibility Preferences -->
            <Border Background="#0CFFFFFF" BorderBrush="#22888888" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Behavioral Pattern Visibility" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Control which behavioral observations are surfaced in your daily timeline and insights." FontSize="13" Foreground="#888888" />

                    <ListView x:Name="ListPatternPrefs" ItemsSource="{Binding PatternPreferences}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*, Auto" Margin="0,6">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#888888" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" SelectedIndex="{Binding Visibility, Mode=TwoWay}" VerticalAlignment="Center">
                                        <ComboBoxItem Content="Show" />
                                        <ComboBoxItem Content="Hide" />
                                        <ComboBoxItem Content="Disable" />
                                    </ComboBox>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Process Exclusions -->
            <Border Background="#0CFFFFFF" BorderBrush="#22888888" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Excluded Applications (Never Tracked)" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Applications in this list will be completely ignored by the tracking coordinator at the WinEvent hook level." FontSize="13" Foreground="#888888" />

                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                        <TextBox x:Name="TxtNewProcess" PlaceholderText="e.g. keepass.exe, 1password.exe" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Add Exclusion" Click="OnAddExclusionClicked" VerticalAlignment="Center" />
                    </Grid>

                    <ListView x:Name="ListExcluded" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*, Auto" Margin="0,4">
                                    <TextBlock Grid.Column="0" Text="{Binding}" FontWeight="Medium" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Remove" Click="OnRemoveExclusionClicked" Tag="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock x:Name="TxtSettingsStatus" Text="" Foreground="#107C41" FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <!-- Innovation: Weekly PDF Report Card -->
            <Border Background="#0CFFFFFF" BorderBrush="#22888888" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Weekly Executive Report Card (PDF)" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Generate a clean, printable 1-2 page PDF summary of your week's focus time, flow states, top apps, and baseline envelope. Rendered 100% locally via QuestPDF." FontSize="13" Foreground="#888888" TextWrapping="Wrap" />

                    <Button Command="{Binding GeneratePdfReportCommand}" Padding="16,8" CornerRadius="6" Background="#180EA5E9" BorderBrush="#330EA5E9">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xEA90;" FontSize="14" Foreground="#0EA5E9" />
                            <TextBlock Text="Generate Weekly Report (PDF)" FontSize="13" FontWeight="SemiBold" Foreground="#0EA5E9" />
                        </StackPanel>
                    </Button>

                    <TextBlock Text="{Binding PdfStatusMessage, Mode=OneWay}" Foreground="#0EA5E9" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Innovation: Encrypted Wellbeing Wallet -->
            <Border Background="#0CFFFFFF" BorderBrush="#22888888" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="Encrypted Wellbeing Wallet (Data Sovereignty)" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Export your entire behavioral history (SQLite database, JSON records, patterns, baselines) into a password-protected AES-256-GCM encrypted archive (.mirrorwallet). No cloud lock-in." FontSize="13" Foreground="#888888" TextWrapping="Wrap" />

                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                        <PasswordBox Password="{Binding WalletPassword, Mode=TwoWay}" PlaceholderText="Enter wallet master encryption password" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Command="{Binding ExportWalletCommand}" Content="Export Encrypted Wallet" VerticalAlignment="Center" Padding="14,6" />
                    </Grid>

                    <TextBlock Text="{Binding WalletStatusMessage, Mode=OneWay}" Foreground="#107C41" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Innovation: Active Pattern Recalibrations -->
            <Border Background="#0CFFFFFF" BorderBrush="#22888888" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Active Pattern Recalibrations" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Dynamic threshold adjustments made via 'This isn't accurate' feedback." FontSize="13" Foreground="#888888" />
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding ResetRecalibrationsCommand}" Content="Reset to Defaults" Padding="12,6" VerticalAlignment="Center" />
                    </Grid>

                    <ListView ItemsSource="{Binding ActiveRecalibrations}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12" Foreground="#0078D4" Margin="0,2" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
