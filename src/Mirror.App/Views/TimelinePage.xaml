<Page
    x:Class="Mirror_App.Views.TimelinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" HorizontalAlignment="Stretch" Margin="8,0,32,32">
            <StackPanel Spacing="4">
                <TextBlock Text="Activity Timeline" FontSize="26" FontWeight="Bold" />
                <TextBlock Text="Chronological breakdown of application focus sessions and transitions." FontSize="14" Foreground="#888888" />
            </StackPanel>

            <!-- Sessions List -->
            <Border Background="#0CFFFFFF" BorderBrush="#22888888" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock x:Name="TxtSessionCount" Text="{Binding SessionCountText, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Background="#150078D4" BorderBrush="#300078D4" BorderThickness="1" CornerRadius="12" Padding="10,4">
                            <TextBlock Text="Updated Every Moment" FontSize="11" FontWeight="SemiBold" Foreground="#0078D4" />
                        </Border>
                    </Grid>
                    <ListView x:Name="ListSessions" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#08FFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,4">
                                    <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                                        <!-- Time pill -->
                                        <Border Grid.Column="0" Background="#150078D4" CornerRadius="6" Padding="10,4" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FormattedTime}" FontSize="12" Foreground="#0078D4" FontWeight="SemiBold" />
                                        </Border>

                                        <!-- App name and Process -->
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" />
                                                <Border Visibility="{Binding IsLiveNow, Mode=OneWay}" Background="#20107C41" BorderBrush="#40107C41" BorderThickness="1" CornerRadius="10" Padding="8,1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <Ellipse Width="6" Height="6" Fill="#107C41" />
                                                        <TextBlock Text="LIVE NOW" FontSize="10" FontWeight="Bold" Foreground="#107C41" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ProcessName}" FontSize="12" Foreground="#888888" />
                                        </StackPanel>

                                        <!-- Category tag -->
                                        <Border Grid.Column="2" Background="{Binding CategoryColor}" Opacity="0.9" CornerRadius="6" Padding="8,3" Margin="0,0,20,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Category}" FontSize="11" Foreground="White" FontWeight="SemiBold" />
                                        </Border>

                                        <!-- Duration & Reason -->
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding DurationFormatted, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Right" Foreground="#0078D4" />
                                            <TextBlock Text="{Binding CloseReasonText, Mode=OneWay}" FontSize="11" Foreground="#888888" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
