<Page
    x:Class="Mirror_App.Views.TrendsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" HorizontalAlignment="Stretch" Margin="8,0,32,32">
            <StackPanel Spacing="4">
                <TextBlock Text="Longitudinal Trends &amp; Baseline" FontSize="26" FontWeight="Bold" />
                <TextBlock Text="7-day activity envelope compared to your 14-day rolling median baseline." FontSize="14" Foreground="#888888" />
            </StackPanel>

            <!-- Day 7 Learning Gate Banner (Active when sample days < 7) -->
            <Border Background="#15F59E0B" BorderBrush="#33F59E0B" BorderThickness="1" CornerRadius="8" Padding="16" Visibility="{Binding IsLearningPhase, Mode=OneWay}">
                <Grid ColumnDefinitions="Auto, *">
                    <FontIcon Grid.Column="0" Glyph="&#xE7BA;" FontSize="22" Foreground="#F59E0B" Margin="0,0,16,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding LearningGateMessage, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="#F59E0B" />
                        <TextBlock Text="Mirror never compares you to remote averages or 'typical users'. To ensure absolute accuracy, baseline deviation patterns remain dormant until 7 full days of local activity are observed." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Adaptive Personal Baseline Synthesis Card -->
            <Border Background="#100078D4" BorderBrush="#330078D4" BorderThickness="1" CornerRadius="8" Padding="20">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Grid.Column="0" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="ADAPTIVE PERSONAL BASELINE" FontSize="11" FontWeight="Bold" Foreground="#0078D4" />
                            <Border Background="#200078D4" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="ROLLING 14-DAY STATISTICAL ENVELOPE" FontSize="9" FontWeight="Bold" Foreground="#0078D4" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="TxtBaselineSummary" Text="{Binding BaselineComparisonText, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding BaselineStatusDescription, Mode=OneWay}" FontSize="12" Foreground="#888888" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="7-DAY DAILY AVG" FontSize="10" FontWeight="Bold" Foreground="#888888" HorizontalAlignment="Right" />
                        <TextBlock x:Name="TxtWeeklyAvg" Text="{Binding WeeklyAverageActive, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="#0078D4" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Statistical Baseline Details Grid (Median, Sigma, Upper Bound) -->
            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="16">
                <Border Grid.Column="0" Background="#0CFFFFFF" BorderBrush="#22888888" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="PERSONAL MEDIAN" FontSize="10" FontWeight="Bold" Foreground="#888888" />
                        <TextBlock Text="{Binding BaselineMedianDailyHours, Mode=OneWay, Converter={x:Null}}" FontSize="20" FontWeight="Bold" Foreground="#0078D4" />
                        <TextBlock Text="14-day rolling median" FontSize="11" Foreground="#666666" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#0CFFFFFF" BorderBrush="#22888888" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="STANDARD DEVIATION (σ)" FontSize="10" FontWeight="Bold" Foreground="#888888" />
                        <TextBlock Text="{Binding StandardDeviationHours, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="#8764B8" />
                        <TextBlock Text="Natural variance envelope" FontSize="11" Foreground="#666666" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#0CFFFFFF" BorderBrush="#22888888" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="FLAGGING THRESHOLD (>2σ)" FontSize="10" FontWeight="Bold" Foreground="#888888" />
                        <TextBlock Text="{Binding UpperBoundHours, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="#107C41" />
                        <TextBlock Text="Patterns trigger only past 2σ" FontSize="11" Foreground="#666666" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 7-Day Bar Chart Presentation -->
            <Border Background="#0CFFFFFF" BorderBrush="#22888888" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Daily Active Hours (Past 7 Days)" FontSize="18" FontWeight="SemiBold" />
                    <ItemsControl x:Name="ItemsDayTrends">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Spacing="8" Width="90">
                                    <TextBlock Text="{Binding ActiveHoursFormatted}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#0078D4" />
                                    <!-- Bar Column -->
                                    <Border Background="#0078D4" Height="{Binding RelativeHeight}" Width="36" CornerRadius="4,4,0,0" HorizontalAlignment="Center" />
                                    <StackPanel HorizontalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding DayName}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding DateFormatted}" FontSize="11" Foreground="#888888" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
